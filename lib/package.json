{
  "name": "lines-db",
  "version": "0.18.0",
  "description": "A database implementation that treats JSONL files as tables using SQLite",
  "type": "module",
  "types": "./dist/index.d.mts",
  "bin": {
    "lines-db": "./bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "default": "./dist/internal.mjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "publint": "publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "database",
    "jsonl",
    "sqlite",
    "seed-data"
  ],
  "author": "toiroakr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/lines-db.git"
  },
  "bugs": {
    "url": "https://github.com/toiroakr/lines-db/issues"
  },
  "homepage": "https://github.com/toiroakr/lines-db#readme",
  "devDependencies": {
    "@loculus/rolldown": "^0.2.3",
    "@types/node": "^24.19.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "typescript": ">=5 <7 || >=7.1.0-0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@politty/loculus": "^0.1.1",
    "@standard-schema/spec": "^1.1.0",
    "amaro": "^1.2.1",
    "loculus": "^0.2.5",
    "zod": "^4.6.6"
  }
}
