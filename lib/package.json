{
  "name": "@toiroakr/lines-db",
  "version": "0.12.5",
  "description": "A database implementation that treats JSONL files as tables using SQLite",
  "type": "module",
  "types": "./dist/index.d.mts",
  "bin": {
    "lines-db": "./bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "publint": "publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "database",
    "jsonl",
    "sqlite",
    "seed-data"
  ],
  "author": "toiroakr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/lines-db.git"
  },
  "bugs": {
    "url": "https://github.com/toiroakr/lines-db/issues"
  },
  "homepage": "https://github.com/toiroakr/lines-db#readme",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "type-fest": "^5.9.0",
    "typescript": "^6.0.3",
    "valibot": "^1.4.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@politty/zod": "^0.1.2",
    "@standard-schema/spec": "^1.1.0",
    "amaro": "^1.1.11",
    "zod": "^4.5.4"
  }
}
