{
  "name": "@lines-db/studio",
  "version": "0.16.0",
  "description": "Browser UI and local server for lines-db",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "ui",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown && pnpm --filter @toiroakr/lines-db-studio-ui build",
    "publint": "publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "toiroakr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/lines-db.git",
    "directory": "studio"
  },
  "peerDependencies": {
    "lines-db": "workspace:^",
    "typescript": ">=5 <7 || >=7.1.0-0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vitest": "^5.0.3",
    "lines-db": "workspace:*",
    "zod": "^4.6.5"
  }
}
