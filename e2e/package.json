{
  "name": "@toiroakr/lines-db-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "e2e": "pnpm --workspace-root build && e2e run",
    "e2e:deterministic": "pnpm e2e tests/studio.e2e.ts",
    "e2e:agent": "pnpm e2e tests/agent.e2e.ts",
    "e2e:report": "node -e \"process.stdout.write(require('node:fs').readFileSync('.e2e/summary.md', 'utf8'))\"",
    "e2e:report:html": "node html-report.ts",
    "e2e:setup": "playwright install chromium && e2e login openai",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@e2e-dev/web": "^0.11.2",
    "@types/node": "^24.19.1",
    "ai": "^7.0.127",
    "e2e": "^0.16.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  }
}
