{
  "name": "@toiroakr/lines-db-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for lines-db library and related packages",
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "build": "pnpm --filter lines-db build && pnpm --filter @lines-db/studio build",
    "test": "pnpm build && pnpm --filter lines-db --filter @lines-db/studio --filter @toiroakr/lines-db-studio-ui test && pnpm --filter @toiroakr/lines-db-tests-unit test",
    "test:all": "pnpm test",
    "e2e": "pnpm --filter @toiroakr/lines-db-e2e e2e",
    "e2e:deterministic": "pnpm --filter @toiroakr/lines-db-e2e e2e:deterministic",
    "e2e:agent": "pnpm --filter @toiroakr/lines-db-e2e e2e:agent",
    "e2e:report": "pnpm --filter @toiroakr/lines-db-e2e e2e:report",
    "e2e:setup": "pnpm --filter @toiroakr/lines-db-e2e e2e:setup",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "example": "pnpm --filter @toiroakr/lines-db-examples example",
    "example:validation": "pnpm --filter @toiroakr/lines-db-examples example:validation",
    "example:json": "pnpm --filter @toiroakr/lines-db-examples example:json",
    "example:datadir": "pnpm --filter @toiroakr/lines-db-examples example:datadir",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "keywords": [
    "database",
    "jsonl",
    "sqlite",
    "seed-data"
  ],
  "author": "toiroakr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/lines-db.git"
  },
  "bugs": {
    "url": "https://github.com/toiroakr/lines-db/issues"
  },
  "homepage": "https://github.com/toiroakr/lines-db#readme",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "lines-db": "workspace:*",
    "@lines-db/studio": "workspace:*"
  }
}
